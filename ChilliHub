-- ===== CHẠY PAYLOAD =====
local function runPayload()
    local url = byGameId[gameId] or byPlaceId[placeId]
    if not url then
        log("Game khong co trong danh sach ho tro")
        return
    end
    log("Dang tai payload:", url)
    for i = 1, 3 do
        local ok, source = pcall(game.HttpGet, game, url)
        if ok and type(source) == "string" and source ~= "" then
            local chunk, err = loadstring(source)
            if chunk then
                local ok2, err2 = pcall(chunk)
                if not ok2 then log("Loi payload:", err2) end
            else
                log("loadstring loi:", err)
            end
            return
        end
        log("Thu lai lan", i)
        task.wait(0.5)
    end
    log("Khong the tai payload")
end

