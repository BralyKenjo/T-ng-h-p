local function tryActivate()
    local entered = Input.Text
    log("Nhap key:", entered)
    if entered == VALID_KEY then
        SubmitBtn.Text = "Key hop le - 24 gio"
        Status.Text = "Da kich hoat 24 gio!"
        Status.TextColor3 = Color3.fromRGB(100, 255, 150)
        grantAccess(DURATION_KEY, "key")
        task.wait(1)
        ScreenGui:Destroy()
        runPayload()
    elseif entered == PREMIUM_KEY then
        SubmitBtn.Text = "Premium - 1 nam"
        Status.Text = "Chao mung Premium! Da kich hoat 1 nam."
        Status.TextColor3 = Color3.fromRGB(255, 215, 0)
        grantAccess(DURATION_PREMIUM, "premium")
        task.wait(1)
        ScreenGui:Destroy()
        runPayload()
    else
        SubmitBtn.Text = "Key khong dung"
        Status.Text = "Key sai hoac khong ton tai, thu lai!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.wait(1.5)
        SubmitBtn.Text = "Xac minh Key"
    end
end

SubmitBtn.MouseButton1Click:Connect(tryActivate)

Input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        tryActivate()
    end
end)

local function handleGetKey(link, btn, name)
    if setclipboard then
        pcall(setclipboard, link)
        btn.Text = "Da copy " .. name .. "! (12 gio)"
    else
        btn.Text = link
    end
    Status.Text = "Da kich hoat 12 gio qua " .. name
    Status.TextColor3 = Color3.fromRGB(100, 200, 255)
    grantAccess(DURATION_LINK, "link_" .. name)
    task.wait(1.2)
    ScreenGui:Destroy()
    runPayload()
end

