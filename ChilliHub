local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local function now()
    return os.time()
end

local function loadData()
    if not (isfile and readfile) then
        if getgenv then return getgenv().ChilliData end
        return nil
    end
    local ok, data = pcall(readfile, KEY_FILE)
    if not ok or not data or data == "" then return nil end
    local ok2, tbl = pcall(HttpService.JSONDecode, HttpService, data)
    if ok2 and type(tbl) == "table" then return tbl end
    return nil
end

local function saveData(tbl)
    if getgenv then getgenv().ChilliData = tbl end
    if writefile then
        pcall(writefile, KEY_FILE, HttpService:JSONEncode(tbl))
    end
end

local function getRemaining()
    local data = loadData()
    if not data or not data.expire then return 0 end
    local left = data.expire - now()
    if left > 0 then return left end
    return 0
end

local function grantAccess(seconds, kind)
    saveData({
        expire = now() + seconds,
        type = kind or "unknown",
        start = now(),
    })
end

