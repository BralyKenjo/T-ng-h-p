-- Nút lấy key (12 giờ)
local function handleGetKey(link, btn, name)
    if setclipboard then
        setclipboard(link)
        btn.Text = "✅ Đã copy " .. name .. "! (12 giờ)"
    else
        btn.Text = "📋 " .. link
    end
    Status.Text = "Đã kích hoạt 12 giờ qua " .. name
    Status.TextColor3 = Color3.fromRGB(100, 200, 255)
    grantAccess(DURATION_LINK, "link_" .. name)
    task.wait(1.2)
    ScreenGui:Destroy()
    runPayload()
end

