-- ===== HỆ THỐNG LƯU TRỮ =====
local function now()
    return os.time()
end

local function loadData()
    if not (isfile and readfile) then
        if getgenv then return getgenv().ChilliData end
        return nil
    end
    local ok, data = pcall(function()
        return isfile(KEY_FILE) and readfile(KEY_FILE)
    end)
    if not ok or not data or data == "" then return nil end
    local ok2, tbl = pcall(function()
        return game:GetService("HttpService"):JSONDecode(data)
    end)
    if ok2 and type(tbl) == "table" then return tbl end
    return nil
end

local function saveData(tbl)
    if getgenv then getgenv().ChilliData = tbl end
    if writefile then
        pcall(function()
            writefile(KEY_FILE, game:GetService("HttpService"):JSONEncode(tbl))
        end)
    end
end

-- Kiểm tra xem còn hiệu lực không
local function getRemaining()
    local data = loadData()
    if not data or not data.expire then return 0 end
    local left = data.expire - now()
    if left > 0 then return left end
    return 0
end

local function grantAccess(seconds, type)
    local data = {
        expire = now() + seconds,
        type = type or "unknown",
        start = now()
    }
    saveData(data)
end

local function formatTime(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    if h > 24 then
        local d = math.floor(h / 24)
        h = h % 24
        return string.format("%d ngày %d giờ", d, h)
    end
    return string.format("%d giờ %d phút", h, m)
end
