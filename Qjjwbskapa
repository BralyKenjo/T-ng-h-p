-- Hàm Animation mở/đóng mượt mà qua lại với Icon tròn
local function animatePopup(show)
    if show then
        MinButton.Visible = false
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 550, 0, 350)})
        tween:Play()
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        tween:Play()
        tween.Completed:Wait()
        MainFrame.Visible = false
        MinButton.Visible = true
    end
end

MinimizeBtn.MouseButton1Click:Connect(function()
    animatePopup(false)
end)

MinButton.MouseButton1Click:Connect(function()
    animatePopup(true)
end)

