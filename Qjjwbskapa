-- Hàm tạo các trang nội dung (Tabs)
local Pages = {}
local function CreateTab(name)
    local Page = Instance.new("ScrollingFrame")
    Page.Name = name .. "Page"
    Page.Parent = RightContainer
    Page.Active = true
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.ScrollBarThickness = 4
    Page.Visible = false
    
    local Layout = Instance.new("UIListLayout")
    Layout.Parent = Page
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 6)
    
    Pages[name] = Page
    return Page
end

-- Tạo sẵn 2 trang trống: Blox Fruit và Steal An Egg
local bfPage = CreateTab("Blox Fruit")
local saePage = CreateTab("Steal An Egg")

-- Hàm phụ trợ để sau này thêm nút script
local function AddScriptButton(targetPage, scriptName, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = "  " .. scriptName
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        pcall(callback)
    end)
    
    targetPage.CanvasSize = UDim2.new(0, 0, 0, targetPage.UIListLayout.AbsoluteContentSize.Y + 10)
end

-- Tính năng tìm kiếm động
SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local text = SearchBox.Text:lower()
    for _, page in pairs(Pages) do
        for _, child in pairs(page:GetChildren()) do
            if child:IsA("TextButton") then
                if text == "" or child.Text:lower():find(text) then
                    child.Visible = true
                else
                    child.Visible = false
                end
            end
        end
    end
end)

-- Hàm tạo nút bấm ở menu bên trái
local function CreateMenuButton(name, targetPage)
    local btn = Instance.new("TextButton")
    btn.Parent = LeftMenu
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.Size = UDim2.new(1, -5, 0, 36)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(170, 170, 190)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Visible = false
        end
        targetPage.Visible = true
    end)
end

